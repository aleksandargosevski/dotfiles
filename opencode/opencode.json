{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git * push *", "effect": "deny" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git git * push *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" }
    }
  }
}
